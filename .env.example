# PalmStory AI — environment variables (NAMES ONLY, no real values here).
# Copy to .env and fill locally. Never commit real secrets.

# --- Core ---
SECRET_KEY=
DATABASE_URL=postgresql://user:pass@localhost:5432/palmstory
REDIS_URL=redis://localhost:6379/0
ENV=development            # development | production
DEV_MOCK_AI=true           # use mock providers, spend no AI credits

# --- AI provider selection (swappable via config) ---
VISION_PROVIDER=mock       # huggingface | gemini | mock
TEXT_PROVIDER=mock         # huggingface | gemini | mock
IMAGE_PROVIDER=svg_fallback # pollinations | hf_sdxl | svg_fallback | mock

# --- Provider credentials (only what your selected providers need) ---
HF_TOKEN=
GEMINI_API_KEY=
# POLLINATIONS needs no key

# --- Image handling / privacy ---
IMAGE_RETENTION_DEFAULT=false   # do NOT persist raw palm images by default
IMAGE_TEMP_TTL_SECONDS=900      # ephemeral store lifetime

# --- Limits ---
MAX_UPLOAD_MB=10
RATE_LIMIT_READINGS_PER_HOUR=20

# --- Async jobs (Phase 11) ---
JOBS_SYNC=false            # true → run reading jobs inline (no background thread)
# For horizontal scaling, swap the in-process runner for Redis + RQ:
# REDIS_URL=redis://localhost:6379/0

# --- Security (Phase 13) ---
SECURE_COOKIES=false       # true in production behind HTTPS (secure cookie + HSTS)
RATE_LIMIT_READINGS_PER_HOUR=20
